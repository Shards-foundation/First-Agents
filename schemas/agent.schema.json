{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "First Agents agent manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "operator",
    "name",
    "runtime",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^(?=[a-z0-9-]{1,39}--)[a-z0-9]+(?:-[a-z0-9]+)*--(?=[a-z0-9-]{1,40}(?![\\s\\S]))[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "maxLength": 81
    },
    "operator": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
      "maxLength": 39
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*(?![\\s\\S])"
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*(?![\\s\\S])"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "repository-analysis",
          "structured-output",
          "code-generation",
          "code-review",
          "documentation",
          "testing",
          "task-execution",
          "agent-collaboration"
        ]
      }
    }
  }
}
